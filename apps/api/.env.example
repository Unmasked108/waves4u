NODE_ENV=development
PORT=4000
# Local dev (API runs on your laptop, Mongo in Docker). directConnection is required here.
# Inside docker-compose the address is overridden automatically.
MONGO_URI=mongodb://localhost:27017/waves4u?directConnection=true
# Public website URL: used for CORS and for links in emails (password reset, renew, invoices)
CLIENT_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Razorpay (Dashboard > Settings > API keys / Webhooks). Webhook URL: https://<site>/api/payments/webhook
# Webhook events: payment.captured, payment.failed, order.paid
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# Channel ID starts with UC (YouTube > About > Share > Copy channel ID)
YOUTUBE_CHANNEL_ID=

# Transactional email over SMTP (Amazon SES, Postmark, Brevo, Zoho...). Set SPF, DKIM and DMARC on the domain.
# Leave SMTP_HOST empty in development: emails are then only printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=waves4u <no-reply@waves4u.com>
# Receives a mail for every "Get a Callback" request
TEAM_EMAIL=

# Cloudflare Turnstile secret key (spam protection on the callback form). Empty = check skipped.
TURNSTILE_SECRET=

# Security
ADMIN_2FA_REQUIRED=true
SINGLE_SESSION=true

# Seller details printed on GST invoices
COMPANY_NAME=waves4u
COMPANY_ADDRESS=Address to be confirmed
COMPANY_STATE=Gujarat
COMPANY_GSTIN=
COMPANY_SAC=998399
SEBI_REG_NO=

# Daily mongodump backup by the worker (needs MongoDB Database Tools; included in the Docker image)
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Used only by `npm run seed`
ADMIN_EMAIL=admin@waves4u.test
ADMIN_PASSWORD=ChangeMe#12345

# Hosting
# true = run the scheduled jobs (emails, reminders, expiry) inside the API instead of the separate worker.
# Use on single-service free hosting (staging). Keep false when the worker container runs.
RUN_JOBS=false
# Proxy hops in front of the API: 1 behind Caddy/Nginx. On staging (Vercel -> Render) use true.
TRUST_PROXY=1
# Same random value as INTERNAL_API_KEY in the website's env. Lets the website's server-side page
# rendering skip the shared rate limit. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
