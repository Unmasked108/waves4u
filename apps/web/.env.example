# Where the backend API runs (server-side only)
API_URL=http://localhost:4000

# Public site URL: used for canonical links, Open Graph, sitemap.xml and structured data (set at build time)
NEXT_PUBLIC_SITE_URL=https://waves4u.com

# Google Analytics 4 measurement ID (G-XXXXXXX). Loads only after the visitor accepts the cookie notice.
# Leave empty to disable analytics and the cookie notice.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification code (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Cloudflare Turnstile site key for the "Get a Callback" form (pair with TURNSTILE_SECRET in the API)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Same random value as INTERNAL_API_KEY in the API's env (server-side only, never exposed to browsers)
INTERNAL_API_KEY=

# true on staging / client-review deployments: blocks all search-engine indexing. Leave empty in production.
SITE_NOINDEX=
